msgid "Just In Time for Pie"
msgstr "Justo a Tiempo para el Pastel"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1918"
msgid "Wolf-Man's Got Nards!"
msgstr "¡El Hombre Lobo Tiene Huevos!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1919"
msgid "BOGUS!"
msgstr "¡QUÉ FARSA!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1920"
msgid "Mummy Came in My House!"
msgstr "¡Una Momia Entró en Mi Casa!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1921"
msgid "That's Why All the Weirdos Are Out!"
msgstr "¡Por Eso Anda Tanta Gente Rara Afuera!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1922"
msgid "Dead Man's Toe!"
msgstr "¡Un Dedo del Pie de un Muerto!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1923"
msgid "Candyman! Candyman! Candyman!"
msgstr "¡Candyman! ¡Candyman! ¡Candyman!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1924"
msgid "Bloody Mary! Bloody Mary!"
msgstr "¡Bloody Mary! ¡Bloody Mary!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1925"
msgid "Come Play With Us, Danny"
msgstr "Ven a jugar con nosotras, Danny"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1926"
msgid "They're Only Noodles, Michael"
msgstr "Solo Son Fideos, Michael"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1927"
msgid "What's This? What's This?"
msgstr "¿Qué es? ¿Qué es?"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1928"
msgid "9, 10, Never Sleep Again"
msgstr "9, 10, Nunca Más Dormirás"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1929"
msgid "It's Only a Dream!"
msgstr "¡Solo Es un Sueño!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1930"
msgid "It's Just a Puzzle Box!"
msgstr "¡Solo es una caja de acertijos!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1931"
msgid "It Was My First Funeral"
msgstr "Fue Mi Primer Funeral"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1932"
msgid "The Rules of the Game Are Very Clear"
msgstr "Las Reglas del Juego Son Muy Claras"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1933"
msgid "We're Friends 'Til the End!"
msgstr "¡Amigos hasta el final!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1934"
msgid "A Mask Tells Us More Than a Face"
msgstr "Una Máscara Revela Más que un Rostro"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1935"
msgid "Have You Come to Sing Pumpkin Carols?"
msgstr "¿Vienes a Cantar Villancicos de Calabaza?"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1936"
msgid "Something Wicked This Way Comes"
msgstr "Algo Maligno Se Acerca"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1937"
msgid "Creature in the dungeon!"
msgstr "¡Una criatura en la mazmorra!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1938"
msgid "Everyone's Entitled to One Good Scare"
msgstr "Todos tienen derecho a un buen susto"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1939"
msgid "Sticky Fingers, Tired Feet..."
msgstr "Dedos Pegajosos, Pies Cansados..."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:1946"
msgid ""
"NOTE: Only removes randomly generated traps, such as pumpkins and arrow traps along \n"
"the edges and hallways of levels. Traps will only be found inside rooms that have \n"
"been designed to contain them."
msgstr ""
"NOTA: Solo elimina trampas aleatorias, como calabazas y trampas de flechas,\n"
"en los bordes y pasillos de los pisos. Solo habrá trampas dentro de las salas\n"
"diseñadas para contenerlas."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2367"
msgid "The symbol defies your grasp and is unable to be retrieved!"
msgstr "¡El símbolo se resiste a tu agarre y no puedes recuperarlo!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2368"
msgid "You place the symbol in the receptacle..."
msgstr "Colocas el símbolo en el receptáculo..."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2370"
msgid "The symbol starts floating!"
msgstr "¡El símbolo empieza a flotar!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2377"
msgid "You see a mystical symbol sitting atop a pedestal."
msgstr "Ves un símbolo místico sobre un pedestal."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2494"
msgid "Bones of dead prisoners litter the cage floor."
msgstr "Huesos de prisioneros muertos cubren el suelo de la jaula."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2495"
msgid "The cage is weak, but its inhabitants were weaker."
msgstr "La jaula es endeble, pero sus ocupantes lo eran aún más."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2497"
msgid "You see a bed with straps."
msgstr "Ves una cama con correas."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2499"
msgid "You see a grim prison cage."
msgstr "Ves una lúgubre jaula de prisión."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2506"
msgid "cell"
msgstr "celda"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2821"
msgid ""
"The %s\n"
" I sensed power from the ghost when you put it on that pedestal."
msgstr ""
"%s\n"
" Sentí el poder del fantasma cuando lo pusiste en ese pedestal."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2823"
msgid ""
"The %s\n"
" I was able to trap some of the power that Herx's ghost released."
msgstr ""
"%s\n"
" Logré atrapar parte del poder que liberó el fantasma de Herx."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2824"
msgid ""
"The %s\n"
" This portal pierces the seal to the Caves using the power of the ghost."
msgstr ""
"%s\n"
" Este portal atraviesa el sello de las Cuevas con el poder del fantasma."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2834"
msgid ""
"%s\n"
" I'm only interested in the rarest of\n"
" artifacts in the land.              \n"
" In particular, the Halloween Symbols that were stolen by Herx."
msgstr ""
"%s\n"
" Solo me interesan los artefactos más\n"
" raros de estas tierras.\n"
" En particular, los símbolos de Halloween que robó Herx."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:2836"
msgid ""
"%s\n"
" You see, a high ranking guild member\n"
" such as myself can extort those mages \n"
" for every penny they own with their \n"
" precious symbols!"
msgstr ""
"%s\n"
" Verás, por mi alto rango en el gremio\n"
" puedo extorsionar a esos magos\n"
" hasta sacarles su última moneda\n"
" gracias a sus preciados símbolos."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:3974"
msgid "The massive pumpkin cannot be moved that way."
msgstr "La enorme calabaza no se puede mover así."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4006"
msgid "Salvage spirit flame"
msgstr "Reciclar llama espiritual"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4007"
msgid "Take spirit flame"
msgstr "Tomar llama espiritual"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4021"
msgid "Push pumpkin"
msgstr "Empujar calabaza"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4022"
msgid "Take symbol"
msgstr "Tomar símbolo"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4024"
msgid "Coax spirit"
msgstr "Persuadir espíritu"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4126"
msgid ""
"Hand the symbol to me directly.\n"
"There is no need to involve\n"
"formalities of gold, now!"
msgstr ""
"Entrégame el símbolo directamente.\n"
"¡Ahora no hace falta\n"
"andar con pagos en oro!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4349"
msgid "pumpkin trap"
msgstr "trampa de calabaza"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:4358"
msgid "pumpkin"
msgstr "calabaza"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/scarony/lang/en.txt:5805"
msgid "Giant Pumpkin"
msgstr "Calabaza Gigante"
