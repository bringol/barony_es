msgid "Player"
msgstr "Jugador"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5210"
msgid "Select the player whose controls you wish to customize."
msgstr "Elige al jugador cuyos controles deseas personalizar."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5211"
msgid "Device"
msgstr "Dispositivo"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5212"
msgid "Select a controller for the given player."
msgstr "Elige el control para el jugador indicado."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5213"
msgid "Profile"
msgstr "Perfil"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5214"
msgid "Select a predefined binding layout for the given player."
msgstr "Elige una disposición predefinida de vínculos para el jugador indicado."

