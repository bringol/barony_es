msgctxt "lang/en.txt:70"
msgid "\"Best of luck, mortal.\""
msgstr "\"La mejor de las suertes, mortal\"."

msgctxt "lang/en.txt:71"
msgid "\"All the best, human.\""
msgstr "\"Todo lo mejor, humano\"."

msgctxt "lang/en.txt:72"
msgid "\"Well, good luck, human.\""
msgstr "\"Bien, buena suerte, humano\"."

msgctxt "lang/en.txt:73"
msgid "\"Hahahahaha!\""
msgstr "\"¡Jajajajaja!\" "

msgctxt "lang/en.txt:74"
msgid "\"My minotaur is hungry!\""
msgstr "\"¡Mi minotauro está hambriento!\"."

msgctxt "lang/en.txt:75"
msgid "\"My pet hungers for human flesh...\""
msgstr "\"Mi mascota anhela la carne humana ...\""

msgctxt "lang/en.txt:76"
msgid "\"The minotaur is coming...\""
msgstr "\"El minotauro se aproxima ...\""

msgctxt "lang/en.txt:77"
msgid "\"Hmm... another mortal at my doorstep...\""
msgstr "\"Hmm ... otro mortal en mi puerta ...\""

msgctxt "lang/en.txt:78"
msgid "\"Ahh, another one joins the fray...\""
msgstr "\"Ahh, otro se une a la refriega ...\""

msgctxt "lang/en.txt:79"
msgid "\"Hmm... someone new...\""
msgstr "\"Hmm ... alguien nuevo ...\" "

msgctxt "lang/en.txt:80"
msgid "\"You'd best not linger for much longer, mortal.\""
msgstr "\"Será mejor que no te demores por mucho más tiempo, mortal\"."

msgctxt "lang/en.txt:81"
msgid "\"What a pity if you should be here when He arrives...\""
msgstr "\"Que pena si estuvieras aquí cuando Él llegue ...\" "

msgctxt "lang/en.txt:82"
msgid "\"You would be wise to abandon this place soon, mortal.\""
msgstr "\"Sería prudente abandonar este lugar pronto, mortal\"."

msgctxt "lang/en.txt:83"
msgid "\"Hmm... this one's still alive.\""
msgstr "\"Hmm ... este sigue vivo\""

msgctxt "lang/en.txt:84"
msgid "\"Hmm, so you've made it this far...\""
msgstr "\"Hmm, así que has llegado hasta aquí ...\""

msgctxt "lang/en.txt:85"
msgid "\"What do you hope to accomplish down here, mortal?\""
msgstr "\"¿Qué esperas lograr aquí, mortal?\""

msgctxt "lang/en.txt:86"
msgid "\"You know nothing of the power that I've found here...\""
msgstr "\"No sabes nada del poder que he encontrado aquí...\""

msgctxt "lang/en.txt:87"
msgid "\"Face me if you dare, mortal. You will not survive.\""
msgstr "\"Enfréntate a mi si te atreves, mortal. No sobrevivirás\"."

msgctxt "lang/en.txt:88"
msgid "\"Meet me in my lair, mortal, and I will show you the meaning of pain.\""
msgstr "\"Ven a mi guarida, mortal, y te mostraré el significado del dolor\"."

msgctxt "lang/en.txt:89"
msgid "\"Welcome to your doom, mortal!\""
msgstr "\"¡Te espera la destrucción, mortal!\""

