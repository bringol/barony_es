msgstr "¡Invocas a un súcubo!"

msgctxt "lang/en.txt:470"
msgid "You drink from the fountain."
msgstr "Bebes de la fuente."

msgctxt "lang/en.txt:471"
msgid "The cool water refreshes you."
msgstr "El agua fría te refresca."

msgctxt "lang/en.txt:472"
msgid "This is a font of holy water!"
msgstr "¡Esta es una fuente de agua bendita!"

msgctxt "lang/en.txt:473"
msgid "The fountain blesses your equipment."
msgstr "La fuente bendice tu equipo."

msgctxt "lang/en.txt:474"
msgid "The fountain dries up!"
msgstr "¡La fuente se seca!"

msgctxt "lang/en.txt:475"
msgid "This gate is opened elsewhere."
msgstr "Esta puerta se abre desde otro sitio."

msgctxt "lang/en.txt:476"
msgid "This is no time for sitting."
msgstr "No es momento para sentarse."

msgctxt "lang/en.txt:477"
msgid "You pound the table in frustration."
msgstr "Aporreas la mesa con frustración."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:478"
msgid "This would be useful in another sort of game."
msgstr "Esto sería útil en otro tipo de juego."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:479"
msgid "You feel like mining and crafting, then it passes."
msgstr "Sientes ganas de minar y crear, luego se te pasa."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:480"
msgid "This strange tool does not belong in this world."
msgstr "Esta extraña herramienta no pertenece a este mundo."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:481"
msgid "You aren't crafting something, so you don't need this."
msgstr "No estás creando algo, así que no necesitas esto."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:482"
msgid "Lesser minds think this belongs to our universe."
msgstr "Mentes menos desarrolladas creen que esto pertenece a nuestro universo."

msgctxt "lang/en.txt:483"
msgid "Picked up a gold piece."
msgstr "Recoges una pieza de oro."

msgctxt "lang/en.txt:484"
msgid "Picked up %d gold pieces."
msgstr "Recoges %d piezas de oro."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:485"
msgid ""
"\"Here lies Johnny Yeast\n"
"  Pardon me for not rising\""
msgstr ""
"\"Aquí yace Juan Pesante\n"
"  Disculpad que no me levante\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:486"
msgid ""
"\"Here lies my wife\n"
"  Here let her lie!\n"
"  Now she's at rest and so am I\""
msgstr ""
"\"Aquí yace mi esposa\n"
" Aquí ella reposa\n"
" Ahora estoy con otra, mucho más maravillosa.\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:487"
msgid ""
"\"Here lies the body of Blake\n"
"  Hit the gas instead of the brake\""
msgstr ""
"\"Aquí yace el cuerpo de Gaspar  \n"
"  Quien aceleró en lugar de frenar\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:488"
msgid ""
"\"Here lies Weird Ed\n"
"  Got his package but now he's dead\""
msgstr ""
"\"Aquí yace Alberto\n"
" Consiguió su paquete pero ahora está muerto\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:489"
msgid "\"Rest in Peace\""
msgstr "\"Descanse En Paz\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:490"
msgid "\"R.I.P.\""
msgstr "\"Q.E.P.D.\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:491"
msgid "\"Sum quod eris\""
msgstr "\"Sum quod eris\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:492"
msgid ""
"\"Off the dock dove Sir Jim\n"
"  Then he found he couldn't swim\""
msgstr ""
"\"Por la borda saltó Don Omar\n"
"  Y luego recordó que no sabia nadar\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:493"
msgid ""
"\"Here lies Mary Poppins\n"
"  A hole in her umbrella proved undoing\""
msgstr ""
"\"Aquí yace Mary Poppins\n"
"  No tapó un agujero en su paraguas\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:494"
msgid ""
"\"Here lies Horace P. Fetch\n"
"  The goblins got him at last\""
msgstr ""
"\"Aquí yace Horacio P. Fetch\n"
"  Al final los trasgos le dieron caza\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:495"
msgid ""
"\"Here lies Julian\n"
"  Got thumped by his pet troll\""
msgstr ""
"\"Aquí yace Julián\n"
"  Machacado por su troll mascota\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:496"
msgid ""
"\"Here lies Ingrid\n"
"  Spooked by a scary skeleton\""
msgstr ""
"\"Aquí descansa Ingrid\n"
"  Un esqueleto le dió un susto de muerte\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:497"
msgid ""
"\"Here lies Sir Robin\n"
"  He bravely ran away\""
msgstr ""
"\"Aquí yace Don Robin\n"
"  Quien valientemente huyó\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:498"
msgid ""
"\"Here lies Tom\n"
"  Lost a game of Russian Roulette\""
msgstr ""
"\"Aquí descansa Tom\n"
"  Perdió una partida de Ruleta Rusa\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:499"
msgid ""
"\"Here lies Mitch\n"
"  Met his end by a lich\""
msgstr ""
"\"Aquí yace Don Agustín\n"
"  El liche supuso su fin\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:500"
msgid ""
"\"Here lies The Proto Pegasus\n"
"  Had a potato stuck in its exhaust pipe\""
msgstr ""
"\"Aquí se encuentra el Proto Pegaso\n"
"  Acabo con una patata en el tubo de escape\""

msgctxt "lang/en.txt:501"
