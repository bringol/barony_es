msgctxt "lang/en.txt:538"
msgid ""
"\"Did you know?\"\n"
"\"You can hear an evil air blowing from traps.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Puedes oír un aire maligno procedente de las trampas.\"\n"
"\"¡Es la verdad!\""

