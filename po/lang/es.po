msgctxt "lang/en.txt:2913"
msgid "Use arrows to set priority for autosort. 0 has no priority."
msgstr "Usar flechas para determinar la prioridad del auto-ord. 0 implica nada de prioidad."

#. Versiones: 3.3.7
msgctxt "lang/en.txt:2914"
msgid "1 is lowest priority, 9 is highest priority to fill left to right.  "
msgstr "1 es la menor prioridad, 9 la mayor prioridad para ordenar de izquierda a derecha.  "

#. Versiones: 3.3.7
msgctxt "lang/en.txt:2915"
msgid "-1 is lowest priority, -9 is highest priority to fill right to left."
msgstr "-1 es la menor prioridad, -9 la mayor prioridad para ordenar de derecha a izquierda."

