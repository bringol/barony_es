msgid ""
"\"Did you know?\"\n"
"\"Fountains sometimes bless your equipment.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"A veces las fuentes pueden bendecir tu equipamiento.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:540"
msgid ""
"\"Did you know?\"\n"
"\"Shopkeepers pay nothing for unidentified gems.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Los comerciantes no pagan por gemas sin identificar.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:541"
msgid ""
"\"Did you know?\"\n"
"\"King Arthur carries the magical sword Dyrnwyn.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Es Rey Arturo posee la espada mágica Dyrnwyn.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:542"
msgid ""
"\"Did you know?\"\n"
"\"You can set off traps with dropped items.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Puedes activar trampas lanzando objetos.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:543"
msgid ""
"\"Did you know?\"\n"
"\"Han shot first.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Han disparó primero.\"\n"
"\"¡Es la verdad!\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:544"
msgid ""
"\"Did you know?\"\n"
"\"Rainbow pony is best pony.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Luciérnaga es la mejor pony.\"\n"
"\"¡Es la verdad!\""

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:545"
msgid ""
"\"Did you know?\"\n"
"\"Spider venom fades in ten seconds.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"El veneno de la tarántula desvanece en diez segundos.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:546"
msgid ""
"\"Did you know?\"\n"
"\"You can find rings in sink drains.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Puedes encontrar anillos en los grifo.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:547"
msgid ""
"\"Did you know?\"\n"
"\"Jet fuel can't melt steel beams.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"El cielo resplandece a mi alrededor (alrededor)\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:548"
msgid ""
"\"Did you know?\"\n"
"\"Gungnir never fails to strike true.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Gungnir nunca falla su objetivo.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:549"
msgid ""
"\"Did you know?\"\n"
"\"Khryselekatos shoots poison arrows.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Khryselekatos dispara flechas envenenadas.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:550"
msgid ""
"\"Did you know?\"\n"
"\"There's a creepy secret hidden in Minetown.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Hay un siniestro secreto oculto en el pueblo minero.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:551"
msgid ""
"\"Did you know?\"\n"
"\"There are two hidden ways into the underworld.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Hay dos caminos secretos hacia el inframundo.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:552"
msgid ""
"\"Did you know?\"\n"
"\"General stores will buy anything.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Las tiendas generales comprarán cualquier cosa.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:553"
msgid ""
"\"Did you know?\"\n"
"\"Certain potions only come in certain colors.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Algunas pociones solo existen en ciertos colores.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:554"
msgid ""
"\"Did you know?\"\n"
"\"There is a secret way into hell in the ruins.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Hay un camino secreto hacia el infierno en las ruinas.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:555"
msgid ""
"\"Did you know?\"\n"
"\"Gungnir is hidden in the Minotaur Maze.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Gungnir esta escondida en el Laberinto del Minotauro.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:556"
msgid ""
"\"Did you know?\"\n"
"\"Khryselekatos lies hidden in the underworld.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Khryselekatos se esconde en el inframundo.\"\n"
"\"¡Es la verdad\""

msgctxt "lang/en.txt:557"
msgid ""
"\"Did you know?\"\n"
"\"Funny Bones carries the axe named Parashu.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Huesos Risueños lleva un hacha llamada Parashu.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:558"
msgid ""
"\"Did you know?\"\n"
"\"A winner is you!\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"¡No contaban con mi astucia!\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:559"
msgid ""
"\"Did you know?\"\n"
"\"I can't leave without my buddy Superfly!\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"La derrota tiene una dignidad que la victoria no conoce.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:560"
msgid ""
"\"Did you know?\"\n"
"\"All toasters toast toast.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Todas las tostadoras tuestan tostadas.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:561"
msgid ""
"\"Did you know?\"\n"
"\"That Mimiga wasn't Sue!\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Violencia es mentir\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:562"
msgid ""
"\"Did you know?\"\n"
"\"Solving Sokoban will make you rich.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Resolver el Sokoban trae riquezas.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:563"
msgid ""
"\"Did you know?\"\n"
"\"Gnomes and trolls are best friends.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Los gnomos y los trolls son grandes amigos.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:564"
msgid ""
"\"Did you know?\"\n"
"\"Shopkeepers really ARE magical geniuses.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Los comerciantes también son EXPERTOS hechiceros.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:565"
msgid ""
"\"Did you know?\"\n"
"\"Trolls would rather just be left alone.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Los trolls prefieren que les dejen en paz.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:566"
msgid ""
"\"Did you know?\"\n"
"\"Minotaurs are not quite invincible.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Los minotaruos no son tan invencibles.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:567"
msgid ""
"\"Did you know?\"\n"
"\"There is no cure for teleportitis.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"No hay cura para teletransportitis.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:568"
msgid ""
"\"Did you know?\"\n"
"\"Broken chests don't yield many items.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"Los cofres rotos no terminan con tantas cosas.\"\n"
"\"¡Es la verdad!\""

msgctxt "lang/en.txt:569"
msgid ""
"\"Did you know?\"\n"
"\"There is no spoon.\"\n"
"\"It's true!\""
msgstr ""
"\"¿Sabías que..?\"\n"
"\"La pelota no se mancha.\"\n"
"\"¡Es la verdad!\""

