msgid "Mouse & Keyboard"
msgstr "Cursor y teclado"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5218"
msgid "Mouse Sensitivity"
msgstr "Sensibilidad del cursor"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5219"
msgid "Control the speed by which mouse movement affects camera movement."
msgstr "Controla la velocidad con la que el movimiento del cursor afecta la cámara."

#. Versiones: 5.0.2
msgctxt "lang/en.txt:5220"
msgid "Hotbar Keys in Inventory"
msgstr "Teclas Numéricas en Inventario"

#. Versiones: 5.0.2
msgctxt "lang/en.txt:5221"
msgid "Allow the player to bind inventory items to the hotbar using the hotbar slot keys on their keyboard."
msgstr "Permite al jugador vincular objetos del inventario a la barra rápida con las teclas numéricas."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5222"
msgid "Reverse Mouse"
msgstr "Cursor Invertido"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5223"
msgid "Reverse mouse up and down movement for controlling the orientation of the player."
msgstr "Invierte el movimiento vertical del cursor al controlar la cámara."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5224"
msgid "Smooth Mouse"
msgstr "Cursor Suavizado"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5225"
msgid "Smooth the movement of the mouse over a few frames of input."
msgstr "Suaviza el movimiento del cursor durante unos cuadros de entrada."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5226"
msgid "Interact Aim Assist"
msgstr "Asistencia al Apuntar"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5227"
msgid "Disable to always use precise cursor targeting on interactable objects and remove interact popups."
msgstr "Desactiva ser siempre preciso cuando el cursor pase sobre objetos interactuables o popups."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5228"
msgid "Controller Settings"
msgstr "Ajustes del Control"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5229"
msgid "Modern"
msgstr "Moderno"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5230"
msgid "Classic"
msgstr "Clasico"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5231"
msgid "Hotbar Layout"
msgstr "Disposición de la Barra Rápida"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5232"
msgid "Modern: Grouped 3x3 slot layout using held buttons. Classic: Flat 10-slot layout with simpler controls."
msgstr "Moderno: Disposición de ranuras 3x3 usando botones sostenidos. Clásico: Disposición plana de 10 ranuras con controles más simples."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5233"
msgid "Turn Sensitivity X"
msgstr "Ajustar Sensibilidad X"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5234"
msgid "Affect the horizontal sensitivity of the control stick used for turning."
msgstr "Afecta la sensibilidad horizontal analógico usado para girar."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5235"
msgid "Turn Sensitivity Y"
msgstr "Cambiar sensibilidad Y"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5236"
msgid "Affect the vertical sensitivity of the control stick used for turning."
msgstr "Afecta la sensibilidad vertical analógico usado para girar."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5237"
msgid "Invert Camera Look X"
msgstr "Invertir Cámara X"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5238"
msgid "Enable to invert left/right look controls of the player camera."
msgstr "Invierte los controles de la cámara para mirar a la izquiera/derecha."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5239"
msgid "Invert Camera Look Y"
msgstr "Invertir Cámara Y"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5240"
msgid "Enable to invert up/down look controls of the player camera."
msgstr "Invierte los controles de la cámara para mirar hacia arriba/abajo."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5241"
msgid "General"
msgstr "General"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5242"
msgid "Streamer Mode"
msgstr "Modo streamer"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5243"
msgid "If you're a streamer and know what doxxing is, definitely switch this on."
msgstr "Si eres streamer y sabes que es el doxeo, definitivamente usa esto."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5244"
msgid "The port number to use when hosting a LAN lobby. (Default: %d)"
msgstr "El número del puerto a usar al crear una sesión LAN (Predeterminado: %d)"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5245"
msgid "LAN"
msgstr "LAN"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5246"
msgid "Port"
msgstr "Puerto"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5247"
msgid "Crossplay"
msgstr "Crossplay"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5248"
msgid "Crossplay Enabled"
msgstr "Crossplay Activo"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5249"
msgid "Enable crossplay through Epic Online Services."
msgstr "Activar Crossplay mediante de Epic Online Services."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5250"
msgid "Game Settings"
msgstr "Ajustes de Juego"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5251"
msgid "Hunger"
msgstr "Hambre"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5252"
msgid "When hunger is off, passive HP regeneration is disabled and eating food heals the player directly."
msgstr "Cuando se desactive el hambre, los PV no se regeneran, y la comida curará directamente"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5253"
msgid "Minotaur"
msgstr "Minotauro"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5254"
msgid "Toggle the minotaur's ability to spawn on many levels after a certain amount of time."
msgstr "Alternar la capacidad del minotauro de aparecer en varios pisos después de cierto tiempo."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5255"
msgid "Random Traps"
msgstr "Trampas Aleatorias"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5256"
msgid "Toggle the random placement of traps throughout each level."
msgstr "Alternar la colocación aleatoria de trampas en cada piso."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5257"
msgid "Friendly Fire"
msgstr "Fuego Amigo"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5258"
msgid "Enable players to harm each other and their allies."
msgstr "Los jugadores pueden dañarse entre sí."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5259"
msgid "Hardcore Mode"
msgstr "Modo Hardcore"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5260"
msgid "Greatly increases the difficulty of all combat encounters."
msgstr "Aumenta enormemente la dificultad de todos los encuentros de combate."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5261"
msgid "Classic Mode"
msgstr "Modo Clásico"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5262"
msgid "Toggle this option to make the game end after the battle with Baron Herx."
msgstr "Activar para que el juego finalice después de la batalla con el Barón Herx."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5263"
msgid "Keep Inventory After Death"
msgstr "Mantener Inventario al Morir"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5264"
msgid "When a player dies, they retain their inventory when revived on the next level."
msgstr "Cuando un jugador muere, conserva su inventario al ser revivido en el siguiente piso."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5265"
msgid "Extra Life"
msgstr "Vida Extra"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5266"
msgid "Start the game with an Amulet of Life-Saving, to prevent one death."
msgstr "Comienza el juego con un Amuleto de Salvación, para evitar una muerte."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5267"
msgid "Cheats"
msgstr "Trucos"

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5268"
msgid "Toggle the ability to activate cheat codes during gameplay."
msgstr "Activa la capacidad de activar trucos durante el juego."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:5269"
msgid "HIGHSCORES"
msgstr "PUNTUACIÓN"

