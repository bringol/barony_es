msgctxt "lang/en.txt:2150"
msgid "becomes a victim of kobold gang violence."
msgstr "se convierte en una víctima de violencia de pandillas."

msgctxt "lang/en.txt:2151"
msgid "underestimates the chewing power of scarab mandibles."
msgstr "subestima el poder de mordedura de la mandíbula del escarabajo."

msgctxt "lang/en.txt:2152"
msgid "gets stuck between a crystal golem and a hard place."
msgstr "se atora entre un gólem de cristal y un lugar duro."

msgctxt "lang/en.txt:2153"
msgid "forgot the safe word for an incubus."
msgstr "olvidó la palabra segura para un íncubo."

msgctxt "lang/en.txt:2154"
msgid "donates blood to the vampire."
msgstr "le dona sangre al vampiro."

msgctxt "lang/en.txt:2155"
msgid "becomes a shadow of their former self."
msgstr "se convierte en una sombra de lo que era."

msgctxt "lang/en.txt:2156"
msgid "waits too long to fight back against the cockatrice."
msgstr "espera mucho tiempo para luchar contra la cocatriz."

msgctxt "lang/en.txt:2157"
msgid "is assassinated by a crafty insectoid."
msgstr "fue asesinado por un insectoide ingenioso."

msgctxt "lang/en.txt:2158"
msgid "gets beaten to death by a drunken goatman."
msgstr "fue golpeado hasta la muerte por un fauno."

msgctxt "lang/en.txt:2159"
msgid "gets terminated by an automaton."
msgstr "fue neutralizado por un autómata."

msgctxt "lang/en.txt:2160"
msgid "failed to foil Erudyce's plans."
msgstr "no consigió frustrar los planes de Erudyce."

msgctxt "lang/en.txt:2161"
msgid "couldn't stand against Orpheus' power."
msgstr "no pudo resistir el poder de Orfeo."

