msgstr "Correveidile"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4252"
msgid ""
"Sorry, those are for\n"
" Extra-Nice kids."
msgstr ""
"Lo siento, eso es para\n"
" quienes tienen conducta ejemplar."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4253"
msgid ""
"Oh no, that's for\n"
" another child."
msgstr ""
"Ah, no, eso es\n"
" para alguien más."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4254"
msgid ""
"Maybe if you're\n"
" nicer next year!"
msgstr ""
"¡Quizá si te portas\n"
" mejor el año que viene!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4255"
msgid ""
"You're on my\n"
" Extra-Nice list!"
msgstr ""
"¡Estás en mi lista\n"
" de conducta ejemplar!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4256"
msgid ""
"That one is addressed\n"
" to you!"
msgstr ""
"¡Este regalo lleva\n"
" tu nombre!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4257"
msgid ""
"Made special for you\n"
" in my workshop."
msgstr ""
"Lo hice para ti\n"
" en mi taller."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4258"
msgid ""
"From my sack's\n"
" secret pouches!"
msgstr ""
"¡De los bolsillos\n"
" secretos de mi saco!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4259"
msgid ""
"I keep a few of those in\n"
"my sleigh, just in case."
msgstr ""
"Guardo algunos en mi\n"
"trineo, por si acaso."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4304"
msgid "You are no longer an enemy of Santa's Helpers."
msgstr "Los ayudantes de Papá Noel ya no te consideran una amenaza."

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4305"
msgid ""
"You are now deemed an enemy of Santa's Helpers\n"
"for inciting violence!"
msgstr ""
"¡Los ayudantes de Papá Noel ahora te consideran una amenaza\n"
"por incitar a la violencia!"

#. Versiones: 4.3.2, 5.0.2
msgctxt "themes/merry/lang/en.txt:4306"
msgid ""
"You are now deemed an enemy of Santa's Helpers\n"
"for accessory to violence!"
msgstr ""
"¡Los ayudantes de Papá Noel ahora te consideran una amenaza\n"
"por complicidad en actos violentos!"

