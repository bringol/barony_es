msgctxt "lang/en.txt:1530"
msgid "diets for a little too long."
msgstr "Hace una dieta demasiado severa."

msgctxt "lang/en.txt:1531"
msgid "is finished off by the poison."
msgstr "Muere por el veneno."

msgctxt "lang/en.txt:1532"
msgid "bleeds to death."
msgstr "Se desangra hasta la muerte."

msgctxt "lang/en.txt:1533"
msgid "burns to a crisp."
msgstr "Arde hasta la médula."

msgctxt "lang/en.txt:1534"
msgid "gets choked to death."
msgstr "Muere por estrangulamiento."

msgctxt "lang/en.txt:1535"
msgid "drinks the funny potion and dies."
msgstr "Bebe una curiosa poción y muere."

