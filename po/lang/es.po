msgctxt "themes/merry/lang/en.txt:5715"
msgid ""
"The elfs are laughing at you!\n"
"Are you really gonna take that?"
msgstr ""
"¡Los duendes se ríen de ti!\n"
"¿De verdad vas a permitirlo?"

