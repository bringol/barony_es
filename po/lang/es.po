msgctxt "lang/en.txt:2350"
msgid "A fragment breaks away from your %s."
msgstr "Un fragmento se separa de tu %s."

msgctxt "lang/en.txt:2351"
msgid "Your %s shatters completely!"
msgstr "¡Tu %s se quiebra completamente!"

msgctxt "lang/en.txt:2352"
msgid "You set off a %s trap!"
msgstr "¡Has activado una trampa de %s!"

msgctxt "lang/en.txt:2353"
msgid "Number of monsters in level: %d"
msgstr "Número de monstruos en el piso: %d"

msgctxt "lang/en.txt:2354"
msgid "WARNING: Experimental - May cause crashing on exit! For model testing only."
msgstr "CUIDADO: Experimental - Puede causar fallos al salir - Solo para testeo de modelos."

msgctxt "lang/en.txt:2355"
msgid "Reloading models from index %d to %d"
msgstr "Recargando modelos del índice %d al %d"

msgctxt "lang/en.txt:2356"
msgid "You rotate the floating crystal."
msgstr "Has rotado el cristal flotante."

msgctxt "lang/en.txt:2357"
msgid "The crystal seems locked in place."
msgstr "El cristal parece estar atorado en el lugar."

msgctxt "lang/en.txt:2358"
msgid "The crystal begins to move!"
msgstr "¡El cristal comienza a moverse!"

msgctxt "lang/en.txt:2359"
msgid "You can't drink an empty bottle!"
msgstr "¡No puedes beber de una botella vacía!"

msgctxt "lang/en.txt:2360"
msgid "You pull the lever, but the mechanism still seems inactive."
msgstr "Tu mueves la palanca, pero el mecanismo parece estar inactivo."

msgctxt "lang/en.txt:2361"
msgid "The lever grinds further along with resistance."
msgstr "La palanca se mueve, pero con resitencia."

msgctxt "lang/en.txt:2362"
msgid "You hear a click from the mechanism!"
msgstr "¡Escuchas un ruido del mecanismo!"

msgctxt "lang/en.txt:2363"
msgid ""
"You attempt to pull the lever back,\n"
"but it retracts beyond your might!"
msgstr ""
"Intentas mover la palanca hacia atrás,\n"
"¡pero resiste tu fuerza!"

msgctxt "lang/en.txt:2364"
msgid "You pound the pedestal in frustration."
msgstr "Golpeas el pedestal de la frustración."

msgctxt "lang/en.txt:2365"
msgid "You admire the intricate carving of the pedestal."
msgstr "Admiras la intrincada escultura del pedestal."

msgctxt "lang/en.txt:2366"
msgid "The pedestal seems to require some sort of primordial artifact."
msgstr "El pedestal parece requerir algún tipo de artefacto primordial."

msgctxt "lang/en.txt:2367"
msgid "The orb defies your grasp and is unable to be retrieved!"
msgstr "La orbe niega tu agarre y no consigues recuperarla!"

msgctxt "lang/en.txt:2368"
msgid "You place the orb in the receptacle..."
msgstr "Colocas la orbe en el receptáculo..."

msgctxt "lang/en.txt:2369"
msgid "But it had no effect."
msgstr "Pero no tiene efecto."

msgctxt "lang/en.txt:2370"
msgid "The orb starts floating!"
msgstr "¡La orbe comienza a flotar!"

msgctxt "lang/en.txt:2371"
msgid "This item has no use here."
msgstr "Este objeto no tiene utilidad aquí."

msgctxt "lang/en.txt:2372"
msgid "This %s appears to be a missing part of some contraption."
msgstr "%s parece faltarle algún tipo de artilugio."

msgctxt "lang/en.txt:2373"
msgid "This %s looks shiny, must be useful! "
msgstr "¡%s se ve brillante, debe ser útil! "

msgctxt "lang/en.txt:2374"
msgid "You retrieve the %s from the pedestal."
msgstr "Tu recuperas %s del pedestal."

msgctxt "lang/en.txt:2375"
msgid "You see a mysterious crystal."
msgstr "Tú avistas un cristal misterioso."

msgctxt "lang/en.txt:2376"
msgid "You see a pedestal."
msgstr "Tu avistas un cristal misterioso."

msgctxt "lang/en.txt:2377"
msgid "You see a mystical orb sitting atop a pedestal."
msgstr "Tu avistas una orbe mística sobre el pedestal."

msgctxt "lang/en.txt:2378"
msgid "You climb the ladder."
msgstr "Subes una escalera."

msgctxt "lang/en.txt:2379"
msgid "Your ally %s gained a level!"
msgstr "¡%s de tu grupo ganó un nivel!"

msgctxt "lang/en.txt:2380"
msgid "The wall is fortified! It doesn't even make a dent!"
msgstr "¡La pared parece fortificada! No tiene ni un rasguño!"

msgctxt "lang/en.txt:2381"
msgid "An unseen force drags your feet to the floor!"
msgstr "¡Una fuerza invisible arrastra tus pies por el suelo!"

msgctxt "lang/en.txt:2382"
msgid "The air here feels like it's swirling gently around you."
msgstr "El aire aquí parece estar girando suavemente a tu alrededor."

msgctxt "lang/en.txt:2383"
msgid "A tingle rolls over your body and through each of your footsteps."
msgstr "Un cosquilleo recorre tu cuerpo en cada pisada."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:2384"
msgid "You feel confident about yourself."
msgstr "El anillo te hace sentir muy bien sobre tu apariencia."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:2385"
msgid "You feel calm."
msgstr "El anillo te da una sensación de calma cuando lo usas."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:2386"
msgid "Your whole body feels scaly."
msgstr "El anillo hace que tu cuerpo se sienta escamoso."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:2387"
msgid "You feel your awareness expanding around you."
msgstr "Cuando te colocas el anillo, sientes hilos buscándote desde las profundidades de tu mente."

#. Versiones: 4.3.2, 5.0.2
msgctxt "lang/en.txt:2388"
msgid "You feel energy surge into your arms."
