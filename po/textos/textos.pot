#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/0"
msgid "*2Hacking your way through every demon in your path, you leap through the\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/1"
msgid ""
"portal.^ No entity, mortal or immortal, can challenge your power.\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/2"
msgid "*2Suddenly, you find yourself standing wearily in an endless white hall dotted\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/3"
msgid "with enormous pillars that stretch higher than you can see.\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/4"
msgid "*2A sense of peace overwhelms and refreshes you. You know that Herx's power has\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/5"
msgid ""
"been removed. But Baphomet was just one devil. A voice comforts you...\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/6"
msgid "*3\"The lich Herx has become dust, but cleverer foes draw upon hellish evil.\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/7"
msgid "Hamlet is free for now, but the world is not safe. In times such as these,\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/8"
msgid ""
"a mighty one must tip the scales. We have a proposition for you...\"\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/9"
msgid "*2Without warning, you are transported back into the mortal realm.\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/10"
msgid ""
"\"You must sever all evil from Hamlet, or there can be no peace.\"\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/11"
msgid "*2With renewed energy, you find yourself standing in Hamlet. Evidence of a\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/12"
msgid ""
"great celebration flows from the gates of the mines to a nearby hostel.\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointAutomaton.json:/text/13"
msgid "*1You know the Magician's Guild will aid you in your quest..."
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/0"
msgid "*2Hacking your way through every demon in your path, you leap through the\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/1"
msgid ""
"portal.^ No entity, mortal or immortal, can challenge your power.\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/2"
msgid "*2Suddenly, you find yourself standing wearily in an endless white hall dotted\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/3"
msgid "with enormous pillars that stretch higher than you can see.\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/4"
msgid "*2Nervously, you wait for your next foe to appear.\n"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/5"
msgid ""
"You are unnerved when a voice booms:\n"
"^"
msgstr ""

#. Versiones: 4.3.2, 5.0.2
msgctxt "data/story/BaphometMidpointBeast.json:/text/6"
msgid "*3\"We have witnessed your strength and lust for power. You are not expected here.\n"
msgstr ""

